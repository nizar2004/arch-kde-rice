[Unit]
Description=arch-kde-rice: keep GPU Screen Recorder replay on the active display
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gsr-replay-watch
KillMode=process
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
