#!/usr/bin/env bash
# =============================================================================
#  backup — snapshot this Arch + KDE Plasma rice into the dotfiles repo and push
#
#  Captures: fish / oh-my-posh / ghostty / fastfetch / Konsole configs, the
#  Plasma panel layout + widget configs, custom plasmoids, the
#  small-taskbar-icon theme, launcher icons, fonts and wallpapers, the
#  power/screen-lock policy — then commits and pushes.
#
#  Usage:  backup [--no-push] [--message "…"]
# =============================================================================
set -euo pipefail

# Locate the repo: explicit override, else the repo this script lives in
# (so the /usr/local/bin/backup symlink works from anywhere), else ~/dotfiles.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
BIN_DIR="$(dirname "$SELF")"
REPO_DEFAULT="$(cd "$BIN_DIR/.." && pwd)"
DOTFILES="${DOTFILES_DIR:-$REPO_DEFAULT}"
BRANCH="${DOTFILES_BRANCH:-main}"
DRY=0
PUSH=1
MSG=""

while [ $# -gt 0 ]; do
    case "$1" in
        --no-push)       PUSH=0 ;;
        --dry-run)       DRY=1 ;;
        -m|--message)    MSG="${2:-}"; shift ;;
        -h|--help)       sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "backup: unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

# shared Catppuccin TUI (gum-accelerated when available)
. "$BIN_DIR/lib/tui.sh"

# ── repo sanity ───────────────────────────────────────────────────────────────
[ -d "$DOTFILES/.git" ] || die "no dotfiles git repo at $DOTFILES (set \$DOTFILES_DIR or clone it)"
cd "$DOTFILES"
STAMP="$(date +%Y%m%d-%H%M%S)"

banner "arch-kde-rice · backup" "snapshot → commit → push"
kv "host"     "$(uname -n)"
kv "user"     "$USER"
kv "repo"     "$DOTFILES"
kv "branch"   "$BRANCH"
[ "$DRY" -eq 1 ] && warn "dry run — nothing will be written"

# --- helpers -----------------------------------------------------------------
# mirror <src> <repo-relative>   (rsync keeps deletions in sync)
mirror() {
    local src="$1" rel="$2"
    if [ ! -e "$src" ]; then warn "skipped (missing): $src"; return 0; fi
    mkdir -p "$(dirname "$DOTFILES/$rel")"
    if [ -d "$src" ]; then
        mkdir -p "$DOTFILES/$rel"
        # --delete keeps the mirror exact, but repo-only notes (README.md,
        # .gitkeep) must survive — protect them from deletion.
        spin_run "$rel" -- rsync -a --delete --exclude '.git' \
              --filter 'protect README.md' --filter 'protect .gitkeep' \
              "$src"/ "$DOTFILES/$rel"/
    else
        spin_run "$rel" -- cp -a "$src" "$DOTFILES/$rel"
    fi
}
copyfile() { # only copy when the source exists; drop the repo copy when it doesn't
    local src="$1" rel="$2"
    if [ -e "$src" ]; then
        mkdir -p "$(dirname "$DOTFILES/$rel")"
        spin_run "$rel" -- cp -a "$src" "$DOTFILES/$rel"
    elif [ -e "$DOTFILES/$rel" ]; then
        rm -f "$DOTFILES/$rel"; warn "removed $rel (gone from the system)"
    fi
}

# ── [1/5] shell & terminal ────────────────────────────────────────────────────
phase 1 5 "shell & terminal"
mirror   "$HOME/.config/fish"             config/fish
mirror   "$HOME/.config/oh-my-posh"       config/oh-my-posh
mirror   "$HOME/.config/ghostty"          config/ghostty
mirror   "$HOME/.config/fastfetch"        config/fastfetch
mirror   "$HOME/.local/share/konsole"     config/konsole   # Command=/usr/bin/fish
copyfile "$HOME/.config/konsolerc"        config/konsolerc

# ── [2/5] fonts & wallpapers ──────────────────────────────────────────────────
phase 2 5 "fonts & wallpapers"
if [ -n "$(ls -A "$HOME/.local/share/fonts" 2>/dev/null)" ]; then
    mirror "$HOME/.local/share/fonts" fonts
else
    info "no user fonts in ~/.local/share/fonts (system Nerd Fonts are used)"
fi
if [ -d "$HOME/Pictures/Wallpaper" ]; then
    mirror "$HOME/Pictures/Wallpaper" wallpapers
elif [ -d "$HOME/Pictures/Wallpapers" ]; then
    warn "using the legacy ~/Pictures/Wallpapers folder (restore creates ~/Pictures/Wallpaper)"
    mirror "$HOME/Pictures/Wallpapers" wallpapers
else
    warn "no ~/Pictures/Wallpaper folder yet"
fi

# ── [3/5] Plasma configuration ────────────────────────────────────────────────
phase 3 5 "Plasma configuration"
for f in plasma-org.kde.plasma.desktop-appletsrc plasmashellrc plasmarc kwinrc \
         kdeglobals kglobalshortcutsrc klauncherrc kwinoutputconfig.json \
         plasmanotifyrc plasma-localerc powerdevilrc kscreenlockerrc; do
    copyfile "$HOME/.config/$f" "plasma/config/$f"
done
mirror "$HOME/.config/kdedefaults" plasma/config/kdedefaults
# remember whose home the absolute paths belong to (restore rewrites them)
printf '%s\n' "$USER" > plasma/.origin-user
info "origin user recorded: $USER"

# ── [4/5] Plasma widgets & data ───────────────────────────────────────────────
phase 4 5 "Plasma widgets & data"
for p in com.cyberbessa.verticalclock com.nizar.dashboard; do
    mirror "$HOME/.local/share/plasma/plasmoids/$p" "plasma/data/plasmoids/$p"
done
mirror "$HOME/.local/share/plasma_icons" plasma/data/plasma_icons
mirror "$HOME/.local/share/plasma/desktoptheme/SmallTaskIcons" plasma/desktoptheme/SmallTaskIcons

# ── [5/5] publish ─────────────────────────────────────────────────────────────
phase 5 5 "publish"
[ -z "$MSG" ] && MSG="backup: $(date '+%Y-%m-%d %H:%M:%S') on $(uname -n)"

CHANGED=0
git add -A
if git diff --cached --quiet; then
    info "nothing changed since the last backup"
else
    CHANGED=1
    if [ "$DRY" -eq 1 ]; then
        dry "commit: $MSG"
    else
        spin_run "committed" -- git commit -q -m "$MSG"
    fi
fi

if [ "$PUSH" -eq 1 ]; then
    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        if [ "$CHANGED" -eq 1 ]; then
            spin_run "pushed to origin/$BRANCH" -- git push -q origin "HEAD:$BRANCH"
        else
            info "already up to date — nothing to push"
        fi
    else
        warn "no upstream set — run:  git -C \"$DOTFILES\" push -u origin $BRANCH"
    fi
else
    warn "skipped push (--no-push)"
fi

N_FILES="$(git ls-files | wc -l)"
done_box "Backup complete — $N_FILES files tracked"
