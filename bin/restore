#!/usr/bin/env bash
# =============================================================================
#  restore — rebuild this Arch + KDE Plasma rice on a fresh install
#
#  Phase 0  sanity + one sudo prompt
#  Phase 1  packages (incl. rog-control-center/asusctl/discord/kdeconnect), oh-my-posh, fish shell
#  Phase 2  fonts + terminal configs (fish, oh-my-posh, ghostty, fastfetch)
#  Phase 3  wallpapers + Plasma slideshow engine
#  Phase 4  Plasma UI: widgets, vertical panel layout, taskbar icon size 29
#  Phase 5  power: no sleep · screen off after 1 h · lid close → screen off · no password
#  Phase 6  KDE Connect: remote commands (shutdown + display switches) on every paired phone
#
#  Usage:  restore [--dry-run]
# =============================================================================
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
BIN_DIR="$(dirname "$SELF")"
REPO_DEFAULT="$(cd "$BIN_DIR/.." && pwd)"
DOTFILES="${DOTFILES_DIR:-$REPO_DEFAULT}"
DRY=0

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY=1 ;;
        -h|--help) sed -n '2,13p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "restore: unknown option: $1 (try --help)" >&2; exit 2 ;;
    esac
    shift
done

# shared Catppuccin TUI (gum-accelerated when available)
. "$BIN_DIR/lib/tui.sh"

# shorthand colors used by the "(dry)" printf lines (tui.sh only defines C_*)
D="$C_DIM" R="$C_RESET"

banner "arch-kde-rice · restore" "rebuild the rice on a fresh Arch + KDE install"

# ── Phase 0: sanity + sudo ────────────────────────────────────────────────────
phase "preflight · sanity & privileges"
[ -d "$DOTFILES" ] || die "dotfiles repo not found at $DOTFILES"
[ "$(id -u)" -ne 0 ] || die "run this as your normal user, not root"
STAMP="$(date +%Y%m%d-%H%M%S)"
ORIGIN_USER="$(cat "$DOTFILES/plasma/.origin-user" 2>/dev/null || echo "$USER")"
ok "repo:    $DOTFILES"
ok "user:    $USER  (config from /home/$ORIGIN_USER)"

if [ "$DRY" -eq 1 ]; then
    warn "--dry-run: nothing will be changed"
else
    step "asking for sudo once (used for packages, fonts, chsh, /usr/local/bin)"
    sudo -v || die "sudo was not granted"
    # keep the sudo timestamp warm during long installs
    ( while true; do sudo -n true 2>/dev/null || exit; sleep 50; done ) & SUDO_KEEP=$!
    trap 'kill "$SUDO_KEEP" 2>/dev/null || true' EXIT
fi

# ── your choice: KDE Connect + phone remote commands? ─────────────────────────
# install.sh asks this too and passes the answer in RICE_KDECONNECT; when you
# run `restore` directly the question is asked here. Default: yes.
if [ -z "${RICE_KDECONNECT:-}" ]; then
    reply=""
    if read -r -p "   Install KDE Connect + phone remote commands? [Y/n] " reply </dev/tty 2>/dev/null; then
        case "$reply" in n|N|no|NO) RICE_KDECONNECT=0 ;; *) RICE_KDECONNECT=1 ;; esac
    else
        RICE_KDECONNECT=1
    fi
fi
export RICE_KDECONNECT
if [ "$RICE_KDECONNECT" = 1 ]; then
    ok "KDE Connect + phone remote commands: yes"
else
    warn "KDE Connect + phone remote commands: no — phase 6 will be skipped"
fi

# ── Phase 1: dependencies & shell ─────────────────────────────────────────────
phase 1 6 "dependencies & default shell"
PKGS=(fish fastfetch ghostty ttf-meslo-nerd git curl unzip fontconfig rsync)
spin_run "pacman · installing ${#PKGS[@]} packages" -- sudo pacman -S --needed --noconfirm "${PKGS[@]}"

# ── ASUS / ROG & daily apps (all in the official repos) ───────────────────────
# rog-control-center + asusctl drive the ASUS hardware (asusd daemon), discord
# for chat, power-profiles-daemon for Plasma's performance profiles and
# kdeconnect so the phone can run remote commands (phase 6). Installed one by
# one so a missing repo can't take the whole phase down.
ASUS_PKGS=(rog-control-center asusctl discord power-profiles-daemon)
if [ "$RICE_KDECONNECT" = 1 ]; then ASUS_PKGS+=(kdeconnect); fi
step "ASUS / ROG & apps · rog-control-center, asusctl, discord, power-profiles-daemon$( [ "$RICE_KDECONNECT" = 1 ] && printf ', kdeconnect' )"
for p in "${ASUS_PKGS[@]}"; do
    spin_run "pacman · $p" -- sudo pacman -S --needed --noconfirm "$p" \
        || warn "$p could not be installed (not in your repos?)"
done

step "power & ASUS services"
spin_run "systemctl enable --now power-profiles-daemon" \
    -- sudo systemctl enable --now power-profiles-daemon \
    || warn "could not enable power-profiles-daemon"
spin_run "systemctl restart asusd" \
    -- sudo systemctl restart asusd \
    || warn "could not restart asusd (is asusctl installed?)"

if ! command -v oh-my-posh >/dev/null 2>&1; then
    step "installing oh-my-posh"
    if command -v yay >/dev/null 2>&1; then
        run yay -S --needed --noconfirm oh-my-posh-bin || warn "yay failed, trying the official installer"
    elif command -v paru >/dev/null 2>&1; then
        run paru -S --needed --noconfirm oh-my-posh-bin || warn "paru failed, trying the official installer"
    fi
    if ! command -v oh-my-posh >/dev/null 2>&1 && [ "$DRY" -eq 0 ]; then
        curl -fsSL https://ohmyposh.dev/install.sh | sudo bash -s -- -d /usr/local/bin \
            || warn "oh-my-posh install failed — install it manually later"
    fi
fi
command -v oh-my-posh >/dev/null 2>&1 && ok "oh-my-posh: $(oh-my-posh version 2>/dev/null || echo present)"

FISH_BIN="$(command -v fish || echo /usr/bin/fish)"

# 1) register fish in /etc/shells — without this, usermod/chsh are silently
#    ignored by login managers and terminal emulators
if ! grep -qxF "$FISH_BIN" /etc/shells 2>/dev/null; then
    spin_run "registering fish in /etc/shells" -- sudo sh -c "printf '%s\\n' '$FISH_BIN' >> /etc/shells"
else
    ok "$FISH_BIN already in /etc/shells"
fi

# 2) force the account login shell for ALL terminals (Konsole, Alacritty, TTYs,
#    VS Code …). usermod is used because chsh can be silently ignored.
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$FISH_BIN" ]; then
    spin_run "usermod -s $FISH_BIN $USER" -- sudo usermod -s "$FISH_BIN" "$USER"
    if [ "$DRY" -eq 0 ]; then
        ok "login shell is now $(getent passwd "$USER" | cut -d: -f7)"
    else
        printf '      %s(dry) usermod → fish%s\n' "$D" "$R"
    fi
else
    ok "login shell already fish"
fi

# ── OS install date → fastfetch "OS Age" ──────────────────────────────────────
# fastfetch reads the first line of ~/.local/state/ArchKDE-SystemRestore/os-install-date
# (falling back to the birth time of /). We pin it to 2026-07-04, and also make
# /var/log/pacman.log agree so other "OS age" tools show the same date.
set_os_install_date() {
    local date="2026-07-04" log=/var/log/pacman.log
    local ts first
    ts="$(date -d "$date 00:00:00" +%s 2>/dev/null || echo 0)"
    first="[2026-07-04T00:00:00+0000] [PACMAN] Running 'pacman -Syu'"

    step "OS install date → $date"

    # 1) the file fastfetch actually reads (no root needed)
    if [ "$DRY" -eq 0 ]; then
        mkdir -p "$HOME/.local/state/ArchKDE-SystemRestore"
        printf '%s\n' "$ts" > "$HOME/.local/state/ArchKDE-SystemRestore/os-install-date"
        ok "~/.local/state/ArchKDE-SystemRestore/os-install-date = $ts ($date)"
    else
        dry "write os-install-date = $ts ($date)"
    fi

    # 2) /var/log/pacman.log — back it up, then make its first entry the date
    if [ "$DRY" -eq 0 ]; then
        if [ -f "$log" ]; then
            if [ ! -f "$log.rice-bak" ]; then
                spin_run "backing up $log → $log.rice-bak" -- sudo cp -a "$log" "$log.rice-bak"
            else
                info "$log.rice-bak already exists"
            fi
            if head -n1 "$log" | grep -qF "[2026-07-04T00:00:00+0000]"; then
                info "pacman.log already starts on $date"
            else
                local tmp; tmp="$(mktemp)"
                { printf '%s\n' "$first"; cat "$log"; } > "$tmp"
                spin_run "prepending the $date entry to pacman.log" -- sudo cp "$tmp" "$log"
                rm -f "$tmp"
            fi
            spin_run "touch -d \"$date 00:00:00\" pacman.log" -- sudo touch -d "$date 00:00:00" "$log"
        else
            warn "$log not found — skipped (fastfetch still uses the state file)"
        fi
    else
        dry "backup $log, prepend '$first', touch -d \"$date 00:00:00\""
    fi
}

set_os_install_date

# ── Phase 2: fonts & terminal configs ─────────────────────────────────────────
phase 2 6 "fonts & terminal configuration"

if [ -n "$(ls -A "$DOTFILES/fonts" 2>/dev/null | grep -v '^\.gitkeep$' || true)" ]; then
    step "deploying user fonts → ~/.local/share/fonts"
    run mkdir -p "$HOME/.local/share/fonts"
    run cp -a "$DOTFILES/fonts/." "$HOME/.local/share/fonts/"
    run fc-cache -f
    ok "custom fonts installed"
else
    warn "no custom font files in the repo (Meslo Nerd Font comes from ttf-meslo-nerd)"
fi

deploy_tree() { # <repo-relative> <destination>
    local src="$DOTFILES/$1" dst="$2"
    [ -e "$src" ] || { warn "missing in repo: $1"; return 0; }
    step "${dst/#$HOME/~}"
    if [ "$DRY" -eq 0 ]; then
        mkdir -p "$(dirname "$dst")"
        [ -e "$dst" ] && mv "$dst" "$dst.bak.$STAMP"
        cp -a "$src" "$dst"
    fi
    ok "restored ${dst/#$HOME/~}"
}

deploy_tree config/fish        "$HOME/.config/fish"
deploy_tree config/oh-my-posh  "$HOME/.config/oh-my-posh"
deploy_tree config/ghostty     "$HOME/.config/ghostty"
deploy_tree config/fastfetch   "$HOME/.config/fastfetch"
deploy_tree config/konsole     "$HOME/.local/share/konsole"   # Konsole profile → Command=/usr/bin/fish
deploy_tree config/konsolerc   "$HOME/.config/konsolerc"      # default profile selection

# ── Phase 3: wallpapers & slideshow ───────────────────────────────────────────
phase 3 6 "wallpapers"
WALL_DIR="$HOME/Pictures/Wallpaper"                  # note: singular
WALL_PATH="/home/$USER/Pictures/Wallpaper/"          # plain path — what Plasma stores
LEGACY_WALL_DIR="$HOME/Pictures/Wallpapers"          # older name, merged if present
step "$WALL_DIR"
if [ "$DRY" -eq 0 ]; then
    mkdir -p "$WALL_DIR"
    # carry over anything already in the older "Wallpapers" folder
    if [ -d "$LEGACY_WALL_DIR" ] && [ "$LEGACY_WALL_DIR" != "$WALL_DIR" ]; then
        cp -an "$LEGACY_WALL_DIR/." "$WALL_DIR"/ 2>/dev/null || true
        ok "merged your existing $LEGACY_WALL_DIR"
    fi
    if [ -d "$DOTFILES/wallpapers" ]; then
        cp -a "$DOTFILES/wallpapers/." "$WALL_DIR"/ || warn "could not copy the repo wallpapers"
    else
        warn "the repo has no wallpapers/ folder"
    fi
fi
IMAGE_COUNT="$(find "$WALL_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    2>/dev/null | wc -l)"
if [ "$IMAGE_COUNT" -gt 0 ]; then
    ok "$IMAGE_COUNT wallpaper image(s) in $WALL_DIR"
else
    warn "no wallpaper images in $WALL_DIR — drop some in and run 'backup' to keep them in the repo"
fi

warn "the slideshow is applied in Phase 4, after the Plasma config is deployed"

# ── Phase 4: Plasma UI & layout ───────────────────────────────────────────────
phase 4 6 "Plasma UI, panels & taskbar icons"

# plasmashell keeps the entire layout in memory and writes it back when it
# exits. Deploying a config while it runs therefore gets clobbered on the next
# restart (the old panel stays, the new applets appear merged into it). So:
# deploy everything with plasmashell STOPPED, then start it exactly once.
plasmashell_stop() {
    if systemctl --user list-unit-files 2>/dev/null | grep -q '^plasma-plasmashell.service'; then
        systemctl --user reset-failed plasma-plasmashell.service 2>/dev/null || true
        systemctl --user stop plasma-plasmashell.service 2>/dev/null || true
    fi
    command -v kquitapp6 >/dev/null 2>&1 && kquitapp6 plasmashell 2>/dev/null || true
    pkill -x plasmashell 2>/dev/null || true
    for _ in $(seq 1 40); do pgrep -x plasmashell >/dev/null 2>&1 || return 0; sleep 0.5; done
    return 0
}
plasmashell_start() {
    if systemctl --user list-unit-files 2>/dev/null | grep -q '^plasma-plasmashell.service'; then
        systemctl --user reset-failed plasma-plasmashell.service 2>/dev/null || true
        systemctl --user start plasma-plasmashell.service 2>/dev/null || true
    else
        ( setsid plasmashell >/dev/null 2>&1 & )
    fi
    for _ in $(seq 1 60); do
        systemctl --user is-active --quiet plasma-plasmashell.service 2>/dev/null && return 0
        pgrep -x plasmashell >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    return 0
}

if [ "$DRY" -eq 1 ]; then
    printf '      %s(dry) stop plasmashell → deploy layout → start plasmashell%s\n' "$D" "$R"
else
    step "stopping plasmashell (its in-memory layout would overwrite the new config)"
    plasmashell_stop && ok "plasmashell stopped"
fi

step "custom widgets (vertical clock, custom start menu)"
for p in "$DOTFILES"/plasma/data/plasmoids/*/; do
    [ -d "$p" ] || continue
    name="$(basename "$p")"
    if [ "$DRY" -eq 0 ]; then
        mkdir -p "$HOME/.local/share/plasma/plasmoids"
        rm -rf "$HOME/.local/share/plasma/plasmoids/$name"
        cp -a "$p" "$HOME/.local/share/plasma/plasmoids/$name"
    fi
    ok "widget: $name"
done

step "panel launcher icons"
if [ "$DRY" -eq 0 ]; then mkdir -p "$HOME/.local/share/plasma_icons"; fi
run cp -a "$DOTFILES/plasma/data/plasma_icons/." "$HOME/.local/share/plasma_icons/"
ok "launcher icons restored"

step "small-taskbar-icon theme (taskbar icons = 29 px)"
if [ "$DRY" -eq 0 ]; then
    mkdir -p "$HOME/.local/share/plasma/desktoptheme"
    rm -rf "$HOME/.local/share/plasma/desktoptheme/SmallTaskIcons"
    cp -a "$DOTFILES/plasma/desktoptheme/SmallTaskIcons" "$HOME/.local/share/plasma/desktoptheme/"
fi
ok "theme SmallTaskIcons installed"

step "Plasma configuration files (layout, panels, shortcuts, theme)"
for f in "$DOTFILES"/plasma/config/*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    if [ "$DRY" -eq 0 ]; then
        [ -e "$HOME/.config/$base" ] && cp -a "$HOME/.config/$base" "$HOME/.config/$base.bak.$STAMP"
        rm -f "$HOME/.config/$base"                 # start clean: no leftover merge
        cp -a "$f" "$HOME/.config/$base"
        # make the captured layout belong to whoever runs this restore
        [ "$ORIGIN_USER" != "$USER" ] && sed -i "s#/home/$ORIGIN_USER#/home/$USER#g" "$HOME/.config/$base" || true
    fi
done
[ -d "$DOTFILES/plasma/config/kdedefaults" ] && deploy_tree plasma/config/kdedefaults "$HOME/.config/kdedefaults"
ok "plasma config restored (layout replaced, not merged)"

# ── wallpaper slideshow (written while plasmashell is stopped) ────────────────
APP="plasma-org.kde.plasma.desktop-appletsrc"
step "wallpaper: every desktop → org.kde.slideshow ($WALL_DIR)"
if [ "$DRY" -eq 0 ]; then
    IDS="$(awk '
        /^\[Containments\]\[[0-9]+\]$/ { id=$0; sub(/^\[Containments\]\[/,"",id); sub(/\]$/,"",id) }
        /^plugin=org\.kde\.plasma\.folder|^plugin=org\.kde\.desktopcontainment/ { print id }
    ' "$HOME/.config/$APP" | sort -u)"
    for id in $IDS; do
        kwriteconfig6 --file "$APP" --group Containments --group "$id" --key wallpaperplugin org.kde.slideshow
        kwriteconfig6 --file "$APP" --group Containments --group "$id" --group Wallpaper \
                      --group org.kde.slideshow --group General --key SlidePaths "$WALL_PATH"
        kwriteconfig6 --file "$APP" --group Containments --group "$id" --group Wallpaper \
                      --group org.kde.slideshow --group General --key SlideInterval 1800
    done
    ok "set org.kde.slideshow on containment(s): $(echo $IDS | tr '\n' ' ')"
else
    printf '      %s(dry) kwriteconfig6: wallpaperplugin=org.kde.slideshow + SlidePaths=%s%s\n' "$D" "$WALL_PATH" "$R"
fi

step "enforcing taskbar icon size 29"
KW="$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)"
if [ -n "$KW" ]; then
    # the icon size comes from the theme's margin hints (panel thickness is
    # untouched); selecting the theme is what applies 29 px.
    run "$KW" --file plasmarc --group Theme --key name SmallTaskIcons
    # belt & braces: some builds also honour an explicit iconSize on icontasks
    run "$KW" --file "$APP" \
        --group Containments --group 2 --group Applets --group 33 \
        --group Configuration --group General --key iconSize 29
    ok "plasmarc Theme=SmallTaskIcons, icontasks iconSize=29"
else
    warn "kwriteconfig6 not found; theme name must be set manually"
fi

step "starting plasmashell with the new layout"
if [ "$DRY" -eq 0 ]; then plasmashell_start && ok "plasmashell is running"; else printf '      %s(dry) start plasmashell%s\n' "$D" "$R"; fi

step "verifying the panels (should be the vertical ones: left / right)"
if [ "$DRY" -eq 0 ] && qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1; then
    LOCS="$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
        'print(JSON.stringify(panels().map(function(p){return p.location})))' 2>/dev/null)"
    ok "panels(): $LOCS"
    case "$LOCS" in
        *'"left"'*|*'"right"'*) ok "vertical panel layout applied ✔" ;;
        *) warn "panels are not vertical — check $HOME/.config/$APP" ;;
    esac
else
    printf '      %s(dry) verify panels()%s\n' "$D" "$R"
fi

step "applying the wallpaper live via org.kde.PlasmaShell.evaluateScript"
if [ "$DRY" -eq 0 ] && qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1; then
    qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var dir = '$WALL_PATH';
        var ds = desktops();
        for (var i = 0; i < ds.length; i++) {
            ds[i].wallpaperPlugin = 'org.kde.slideshow';
            ds[i].currentConfigGroup = ['Wallpaper', 'org.kde.slideshow', 'General'];
            ds[i].writeConfig('SlidePaths', dir);
            ds[i].writeConfig('SlideInterval', 1800);
            if (ds[i].reloadConfig) { ds[i].reloadConfig(); }
        }
    " >/dev/null 2>&1
    PLUGS="$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
        'print(JSON.stringify(desktops().map(function(d){return d.wallpaperPlugin})))' 2>/dev/null)"
    ok "desktop wallpaper plugins: $PLUGS"
    STORED="$(kreadconfig6 --file "$APP" --group Containments --group 1 --group Wallpaper \
        --group org.kde.slideshow --group General --key SlidePaths 2>/dev/null)"
    ok "stored SlidePaths: $STORED"
else
    printf '      %s(dry) evaluateScript: desktops() → org.kde.slideshow%s\n' "$D" "$R"
fi

# ── Phase 5: power, screen & lock ─────────────────────────────────────────────
# Exactly what this rice wants from a laptop:
#   · never sleep on idle (any power source — the PC keeps running)
#   · screen turns off after 1 h of inactivity
#   · closing the lid while plugged in → screen off only (no sleep)
#   · never lock the screen, never ask for a password
# Values verified against the Plasma 6.8 powerdevil schema:
#   AutoSuspendAction / LidAction (PowerButtonAction):
#     NoAction=0  Sleep=1  Hibernate=2  Shutdown=8  LockScreen=32
#     TurnOffScreen=64  ToggleScreenOnOff=128
#   idle timeouts are SECONDS in the Plasma 6.8 schema
phase 5 6 "power: no sleep · screen off after 1 h · no password"

POWER_KW="$(command -v kwriteconfig6 || true)"
if [ -z "$POWER_KW" ]; then
    warn "kwriteconfig6 not found — power & lock settings skipped"
elif [ "$DRY" -eq 1 ]; then
    dry "powerdevilrc: AutoSuspendAction=0 (AC/Battery/LowBattery), LidAction=64 (AC)"
    dry "powerdevilrc: TurnOffDisplayWhenIdle=true + TurnOffDisplayIdleTimeoutSec=3600 + LockBeforeTurnOffDisplay=false"
    dry "kscreenlockerrc: Autolock=false, Timeout=0, LockOnResume=false, RequirePassword=false"
else
    step "never sleep on idle · screen off after 1 h (AC, Battery, LowBattery)"
    for p in AC Battery LowBattery; do
        "$POWER_KW" --file powerdevilrc --group "$p" --group SuspendAndShutdown --key AutoSuspendAction 0
        "$POWER_KW" --file powerdevilrc --group "$p" --group Display --key TurnOffDisplayWhenIdle true
        "$POWER_KW" --file powerdevilrc --group "$p" --group Display --key TurnOffDisplayIdleTimeoutSec 3600
        "$POWER_KW" --file powerdevilrc --group "$p" --group Display --key LockBeforeTurnOffDisplay false
    done
    ok "idle: PC keeps running, screen off after 1 h (never locked first)"

    step "closing the lid on AC → screen off only"
    "$POWER_KW" --file powerdevilrc --group AC --group SuspendAndShutdown --key LidAction 64
    ok "LidAction=TurnOffScreen (64) on the AC profile"

    step "never lock, never ask for a password"
    "$POWER_KW" --file kscreenlockerrc --group Daemon --key Autolock false
    "$POWER_KW" --file kscreenlockerrc --group Daemon --key Timeout 0
    "$POWER_KW" --file kscreenlockerrc --group Daemon --key LockOnResume false
    "$POWER_KW" --file kscreenlockerrc --group Daemon --key RequirePassword false
    ok "screen locker: no idle lock, no lock on wake, no password"

    step "applying live (powerdevil restart + locker reload)"
    systemctl --user restart plasma-powerdevil.service 2>/dev/null || true
    qdbus6 org.kde.screensaver /ScreenSaver configure 2>/dev/null || true
    ok "settings are live"

    step "verifying the live state"
    LID="$(qdbus6 org.kde.Solid.PowerManagement \
                /org/kde/Solid/PowerManagement/Actions/HandleButtonEvents \
                org.kde.Solid.PowerManagement.Actions.HandleButtonEvents.lidAction 2>/dev/null || echo '?')"
    NOK="$(kreadconfig6 --file kscreenlockerrc --group Daemon --key RequirePassword 2>/dev/null || echo '?')"
    if [ "$LID" = "64" ]; then ok "lid close = screen off (LidAction=$LID) ✔"; else warn "LidAction=$LID (expected 64)"; fi
    if [ "$NOK" = "false" ]; then ok "RequirePassword=$NOK ✔"; else warn "RequirePassword=$NOK (expected false)"; fi
fi

# ── Phase 6: KDE Connect · remote commands ────────────────────────────────────
# Installs three commands the phone can run from the KDE Connect app:
#   · Shut down PC               → systemctl poweroff
#   · Display: main screen only  → kc-display main
#   · Display: HDMI screen only  → kc-display external
# A user path unit re-installs them automatically whenever a new device is
# paired. kc-display auto-detects the outputs at run time (eDP* = laptop
# panel, HDMI*/DP* = external), so this works unchanged on any machine.
phase 6 7 "KDE Connect · remote commands"

if [ "$RICE_KDECONNECT" != 1 ]; then
    info "skipped — KDE Connect was declined (run: RICE_KDECONNECT=1 restore to add it later)"
elif [ "$DRY" -eq 1 ]; then
    dry "link ~/.local/bin/kc-display → bin/kc-display"
    dry "link /usr/local/bin/kdeconnect-sync → bin/kdeconnect-sync"
    dry "install rice-kdeconnect-sync.{service,path} → ~/.config/systemd/user"
    dry "systemctl --user enable --now rice-kdeconnect-sync.path"
    dry "run kdeconnect-sync (adds the commands to every paired device)"
else
    run mkdir -p "$HOME/.local/bin" "$HOME/.config/systemd/user" "$HOME/.config/kdeconnect"

    step "display switcher → ~/.local/bin/kc-display"
    run ln -sf "$DOTFILES/bin/kc-display" "$HOME/.local/bin/kc-display"
    ok "kc-display installed (main / external / status)"

    step "pairing watcher → ~/.config/systemd/user"
    for u in rice-kdeconnect-sync.service rice-kdeconnect-sync.path; do
        cp -a "$DOTFILES/systemd/user/$u" "$HOME/.config/systemd/user/$u"
    done
    systemctl --user daemon-reload
    systemctl --user enable --now rice-kdeconnect-sync.path 2>/dev/null || true
    ok "watching ~/.config/kdeconnect — new pairings get the commands automatically"

    step "installing the commands on every paired device"
    "$DOTFILES/bin/kdeconnect-sync" || warn "kdeconnect-sync had a hiccup — run it again later"
    if ! pgrep -x kdeconnectd >/dev/null 2>&1; then
        info "kdeconnectd is not running yet — commands will be pushed on first pairing"
    fi
fi

# ── install the global commands ───────────────────────────────────────────────
phase 7 7 "global commands"
CMDS=(backup restore)
[ "$RICE_KDECONNECT" = 1 ] && CMDS+=(kdeconnect-sync)
for c in "${CMDS[@]}"; do
    spin_run "/usr/local/bin/$c → $DOTFILES/bin/$c" -- sudo ln -sf "$DOTFILES/bin/$c" "/usr/local/bin/$c"
done

done_box "Restore complete — log out and back in so fish fully applies"
