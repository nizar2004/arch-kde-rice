#!/usr/bin/env bash
# =============================================================================
#  restore — rebuild this Arch + KDE Plasma rice on a fresh install
#
#  Phase 0  sanity + one sudo prompt
#  Phase 1  packages, oh-my-posh, fish as the login shell
#  Phase 2  fonts + terminal configs (fish, oh-my-posh, ghostty, fastfetch)
#  Phase 3  wallpapers + Plasma slideshow engine
#  Phase 4  Plasma UI: widgets, vertical panel layout, taskbar icon size 29
#
#  Usage:  restore [--dry-run]
# =============================================================================
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DEFAULT="$(cd "$(dirname "$SELF")/.." && pwd)"
DOTFILES="${DOTFILES_DIR:-$REPO_DEFAULT}"
DRY=0

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY=1 ;;
        -h|--help) sed -n '2,12p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "restore: unknown option: $1 (try --help)" >&2; exit 2 ;;
    esac
    shift
done

# ── pretty output ─────────────────────────────────────────────────────────────
if [ -t 1 ]; then
    B=$'\e[1m'; R=$'\e[0m'; D=$'\e[2m'
    AC=$'\e[38;5;39m'; OK=$'\e[38;5;42m'; WARN=$'\e[38;5;214m'
    ERR=$'\e[38;5;203m'; T=$'\e[38;5;170m'
else
    B=; R=; D=; AC=; OK=; WARN=; ERR=; T=
fi
phase() { printf '\n%s┳━ %s%s%s\n' "$T" "$B" "$*" "$R"; }
step()  { printf '%s┃%s  %s▸%s %s\n' "$AC" "$AC" "$B" "$R" "$*"; }
ok()    { printf '%s┃%s    %s✔%s %s\n' "$AC" "$AC" "$OK" "$R" "$*"; }
warn()  { printf '%s┃%s    %s▲%s %s\n' "$AC" "$AC" "$WARN" "$R" "$*"; }
die()   { printf '%s┗━✘ %s%s\n' "$ERR" "$*" "$R" >&2; exit 1; }
done_() { printf '%s┻━ %s✔ %s%s\n' "$AC" "$OK" "$*" "$R"; }

run() { if [ "$DRY" -eq 1 ]; then printf '      %s(dry) %s%s\n' "$D" "$*" "$R"; else "$@"; fi; }

# ── Phase 0: sanity + sudo ────────────────────────────────────────────────────
phase "Phase 0 · sanity & privileges"
[ -d "$DOTFILES" ] || die "dotfiles repo not found at $DOTFILES"
[ "$(id -u)" -ne 0 ] || die "run this as your normal user, not root"
STAMP="$(date +%Y%m%d-%H%M%S)"
ORIGIN_USER="$(cat "$DOTFILES/plasma/.origin-user" 2>/dev/null || echo "$USER")"
ok "repo:    $DOTFILES"
ok "user:    $USER  (config from /home/$ORIGIN_USER)"

if [ "$DRY" -eq 1 ]; then
    warn "--dry-run: nothing will be changed"
else
    step "asking for sudo once (used for packages, fonts, chsh, /usr/local/bin)"
    sudo -v || die "sudo was not granted"
    # keep the sudo timestamp warm during long installs
    ( while true; do sudo -n true 2>/dev/null || exit; sleep 50; done ) & SUDO_KEEP=$!
    trap 'kill "$SUDO_KEEP" 2>/dev/null || true' EXIT
fi

# ── Phase 1: dependencies & shell ─────────────────────────────────────────────
phase "Phase 1 · dependencies & default shell"
PKGS=(fish fastfetch ghostty ttf-meslo-nerd git curl unzip fontconfig rsync)
step "pacman -S --needed ${PKGS[*]}"
run sudo pacman -S --needed --noconfirm "${PKGS[@]}"
ok "core packages present"

if ! command -v oh-my-posh >/dev/null 2>&1; then
    step "installing oh-my-posh"
    if command -v yay >/dev/null 2>&1; then
        run yay -S --needed --noconfirm oh-my-posh-bin || warn "yay failed, trying the official installer"
    elif command -v paru >/dev/null 2>&1; then
        run paru -S --needed --noconfirm oh-my-posh-bin || warn "paru failed, trying the official installer"
    fi
    if ! command -v oh-my-posh >/dev/null 2>&1 && [ "$DRY" -eq 0 ]; then
        curl -fsSL https://ohmyposh.dev/install.sh | sudo bash -s -- -d /usr/local/bin \
            || warn "oh-my-posh install failed — install it manually later"
    fi
fi
command -v oh-my-posh >/dev/null 2>&1 && ok "oh-my-posh: $(oh-my-posh version 2>/dev/null || echo present)"

FISH_BIN="$(command -v fish || echo /usr/bin/fish)"

# 1) register fish in /etc/shells — without this, usermod/chsh are silently
#    ignored by login managers and terminal emulators
if ! grep -qxF "$FISH_BIN" /etc/shells 2>/dev/null; then
    step "register $FISH_BIN in /etc/shells"
    run sudo sh -c "printf '%s\\n' '$FISH_BIN' >> /etc/shells"
    ok "/etc/shells updated"
else
    ok "$FISH_BIN already in /etc/shells"
fi

# 2) force the account login shell for ALL terminals (Konsole, Alacritty, TTYs,
#    VS Code …). usermod is used because chsh can be silently ignored.
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$FISH_BIN" ]; then
    step "usermod -s $FISH_BIN $USER"
    run sudo usermod -s "$FISH_BIN" "$USER"
    if [ "$DRY" -eq 0 ]; then
        ok "login shell is now $(getent passwd "$USER" | cut -d: -f7)"
    else
        printf '      %s(dry) usermod → fish%s\n' "$D" "$R"
    fi
else
    ok "login shell already fish"
fi

# ── Phase 2: fonts & terminal configs ─────────────────────────────────────────
phase "Phase 2 · fonts & terminal configuration"

if [ -n "$(ls -A "$DOTFILES/fonts" 2>/dev/null | grep -v '^\.gitkeep$' || true)" ]; then
    step "deploying user fonts → ~/.local/share/fonts"
    run mkdir -p "$HOME/.local/share/fonts"
    run cp -a "$DOTFILES/fonts/." "$HOME/.local/share/fonts/"
    run fc-cache -f
    ok "custom fonts installed"
else
    warn "no custom font files in the repo (Meslo Nerd Font comes from ttf-meslo-nerd)"
fi

deploy_tree() { # <repo-relative> <destination>
    local src="$DOTFILES/$1" dst="$2"
    [ -e "$src" ] || { warn "missing in repo: $1"; return 0; }
    step "${dst/#$HOME/~}"
    if [ "$DRY" -eq 0 ]; then
        mkdir -p "$(dirname "$dst")"
        [ -e "$dst" ] && mv "$dst" "$dst.bak.$STAMP"
        cp -a "$src" "$dst"
    fi
    ok "restored ${dst/#$HOME/~}"
}

deploy_tree config/fish        "$HOME/.config/fish"
deploy_tree config/oh-my-posh  "$HOME/.config/oh-my-posh"
deploy_tree config/ghostty     "$HOME/.config/ghostty"
deploy_tree config/fastfetch   "$HOME/.config/fastfetch"
deploy_tree config/konsole     "$HOME/.local/share/konsole"   # Konsole profile → Command=/usr/bin/fish
deploy_tree config/konsolerc   "$HOME/.config/konsolerc"      # default profile selection

# ── Phase 3: wallpapers & slideshow ───────────────────────────────────────────
phase "Phase 3 · wallpapers"
WALL_DIR="$HOME/Pictures/Wallpaper"                  # note: singular
WALL_PATH="/home/$USER/Pictures/Wallpaper/"          # plain path — what Plasma stores
LEGACY_WALL_DIR="$HOME/Pictures/Wallpapers"          # older name, merged if present
step "$WALL_DIR"
if [ "$DRY" -eq 0 ]; then
    mkdir -p "$WALL_DIR"
    # carry over anything already in the older "Wallpapers" folder
    if [ -d "$LEGACY_WALL_DIR" ] && [ "$LEGACY_WALL_DIR" != "$WALL_DIR" ]; then
        cp -an "$LEGACY_WALL_DIR/." "$WALL_DIR"/ 2>/dev/null || true
        ok "merged your existing $LEGACY_WALL_DIR"
    fi
    if [ -d "$DOTFILES/wallpapers" ]; then
        cp -a "$DOTFILES/wallpapers/." "$WALL_DIR"/ || warn "could not copy the repo wallpapers"
    else
        warn "the repo has no wallpapers/ folder"
    fi
fi
IMAGE_COUNT="$(find "$WALL_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    2>/dev/null | wc -l)"
if [ "$IMAGE_COUNT" -gt 0 ]; then
    ok "$IMAGE_COUNT wallpaper image(s) in $WALL_DIR"
else
    warn "no wallpaper images in $WALL_DIR — drop some in and run 'backup' to keep them in the repo"
fi

warn "the slideshow is applied in Phase 4, after the Plasma config is deployed"

# ── Phase 4: Plasma UI & layout ───────────────────────────────────────────────
phase "Phase 4 · Plasma UI, panels & taskbar icons"

# plasmashell keeps the entire layout in memory and writes it back when it
# exits. Deploying a config while it runs therefore gets clobbered on the next
# restart (the old panel stays, the new applets appear merged into it). So:
# deploy everything with plasmashell STOPPED, then start it exactly once.
plasmashell_stop() {
    if systemctl --user list-unit-files 2>/dev/null | grep -q '^plasma-plasmashell.service'; then
        systemctl --user reset-failed plasma-plasmashell.service 2>/dev/null || true
        systemctl --user stop plasma-plasmashell.service 2>/dev/null || true
    fi
    command -v kquitapp6 >/dev/null 2>&1 && kquitapp6 plasmashell 2>/dev/null || true
    pkill -x plasmashell 2>/dev/null || true
    for _ in $(seq 1 40); do pgrep -x plasmashell >/dev/null 2>&1 || return 0; sleep 0.5; done
    return 0
}
plasmashell_start() {
    if systemctl --user list-unit-files 2>/dev/null | grep -q '^plasma-plasmashell.service'; then
        systemctl --user reset-failed plasma-plasmashell.service 2>/dev/null || true
        systemctl --user start plasma-plasmashell.service 2>/dev/null || true
    else
        ( setsid plasmashell >/dev/null 2>&1 & )
    fi
    for _ in $(seq 1 60); do
        systemctl --user is-active --quiet plasma-plasmashell.service 2>/dev/null && return 0
        pgrep -x plasmashell >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    return 0
}

if [ "$DRY" -eq 1 ]; then
    printf '      %s(dry) stop plasmashell → deploy layout → start plasmashell%s\n' "$D" "$R"
else
    step "stopping plasmashell (its in-memory layout would overwrite the new config)"
    plasmashell_stop && ok "plasmashell stopped"
fi

step "custom widgets (vertical clock, custom start menu)"
for p in "$DOTFILES"/plasma/data/plasmoids/*/; do
    [ -d "$p" ] || continue
    name="$(basename "$p")"
    if [ "$DRY" -eq 0 ]; then
        mkdir -p "$HOME/.local/share/plasma/plasmoids"
        rm -rf "$HOME/.local/share/plasma/plasmoids/$name"
        cp -a "$p" "$HOME/.local/share/plasma/plasmoids/$name"
    fi
    ok "widget: $name"
done

step "panel launcher icons"
if [ "$DRY" -eq 0 ]; then mkdir -p "$HOME/.local/share/plasma_icons"; fi
run cp -a "$DOTFILES/plasma/data/plasma_icons/." "$HOME/.local/share/plasma_icons/"
ok "launcher icons restored"

step "small-taskbar-icon theme (taskbar icons = 29 px)"
if [ "$DRY" -eq 0 ]; then
    mkdir -p "$HOME/.local/share/plasma/desktoptheme"
    rm -rf "$HOME/.local/share/plasma/desktoptheme/SmallTaskIcons"
    cp -a "$DOTFILES/plasma/desktoptheme/SmallTaskIcons" "$HOME/.local/share/plasma/desktoptheme/"
fi
ok "theme SmallTaskIcons installed"

step "Plasma configuration files (layout, panels, shortcuts, theme)"
for f in "$DOTFILES"/plasma/config/*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    if [ "$DRY" -eq 0 ]; then
        [ -e "$HOME/.config/$base" ] && cp -a "$HOME/.config/$base" "$HOME/.config/$base.bak.$STAMP"
        rm -f "$HOME/.config/$base"                 # start clean: no leftover merge
        cp -a "$f" "$HOME/.config/$base"
        # make the captured layout belong to whoever runs this restore
        [ "$ORIGIN_USER" != "$USER" ] && sed -i "s#/home/$ORIGIN_USER#/home/$USER#g" "$HOME/.config/$base" || true
    fi
done
[ -d "$DOTFILES/plasma/config/kdedefaults" ] && deploy_tree plasma/config/kdedefaults "$HOME/.config/kdedefaults"
ok "plasma config restored (layout replaced, not merged)"

# ── wallpaper slideshow (written while plasmashell is stopped) ────────────────
APP="plasma-org.kde.plasma.desktop-appletsrc"
step "wallpaper: every desktop → org.kde.slideshow ($WALL_DIR)"
if [ "$DRY" -eq 0 ]; then
    IDS="$(awk '
        /^\[Containments\]\[[0-9]+\]$/ { id=$0; sub(/^\[Containments\]\[/,"",id); sub(/\]$/,"",id) }
        /^plugin=org\.kde\.plasma\.folder|^plugin=org\.kde\.desktopcontainment/ { print id }
    ' "$HOME/.config/$APP" | sort -u)"
    for id in $IDS; do
        kwriteconfig6 --file "$APP" --group Containments --group "$id" --key wallpaperplugin org.kde.slideshow
        kwriteconfig6 --file "$APP" --group Containments --group "$id" --group Wallpaper \
                      --group org.kde.slideshow --group General --key SlidePaths "$WALL_PATH"
        kwriteconfig6 --file "$APP" --group Containments --group "$id" --group Wallpaper \
                      --group org.kde.slideshow --group General --key SlideInterval 1800
    done
    ok "set org.kde.slideshow on containment(s): $(echo $IDS | tr '\n' ' ')"
else
    printf '      %s(dry) kwriteconfig6: wallpaperplugin=org.kde.slideshow + SlidePaths=%s%s\n' "$D" "$WALL_PATH" "$R"
fi

step "enforcing taskbar icon size 29"
KW="$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)"
if [ -n "$KW" ]; then
    # the icon size comes from the theme's margin hints (panel thickness is
    # untouched); selecting the theme is what applies 29 px.
    run "$KW" --file plasmarc --group Theme --key name SmallTaskIcons
    # belt & braces: some builds also honour an explicit iconSize on icontasks
    run "$KW" --file "$APP" \
        --group Containments --group 2 --group Applets --group 33 \
        --group Configuration --group General --key iconSize 29
    ok "plasmarc Theme=SmallTaskIcons, icontasks iconSize=29"
else
    warn "kwriteconfig6 not found; theme name must be set manually"
fi

step "starting plasmashell with the new layout"
if [ "$DRY" -eq 0 ]; then plasmashell_start && ok "plasmashell is running"; else printf '      %s(dry) start plasmashell%s\n' "$D" "$R"; fi

step "verifying the panels (should be the vertical ones: left / right)"
if [ "$DRY" -eq 0 ] && qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1; then
    LOCS="$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
        'print(JSON.stringify(panels().map(function(p){return p.location})))' 2>/dev/null)"
    ok "panels(): $LOCS"
    case "$LOCS" in
        *'"left"'*|*'"right"'*) ok "vertical panel layout applied ✔" ;;
        *) warn "panels are not vertical — check $HOME/.config/$APP" ;;
    esac
else
    printf '      %s(dry) verify panels()%s\n' "$D" "$R"
fi

step "applying the wallpaper live via org.kde.PlasmaShell.evaluateScript"
if [ "$DRY" -eq 0 ] && qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1; then
    qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var dir = '$WALL_PATH';
        var ds = desktops();
        for (var i = 0; i < ds.length; i++) {
            ds[i].wallpaperPlugin = 'org.kde.slideshow';
            ds[i].currentConfigGroup = ['Wallpaper', 'org.kde.slideshow', 'General'];
            ds[i].writeConfig('SlidePaths', dir);
            ds[i].writeConfig('SlideInterval', 1800);
            if (ds[i].reloadConfig) { ds[i].reloadConfig(); }
        }
    " >/dev/null 2>&1
    PLUGS="$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
        'print(JSON.stringify(desktops().map(function(d){return d.wallpaperPlugin})))' 2>/dev/null)"
    ok "desktop wallpaper plugins: $PLUGS"
    STORED="$(kreadconfig6 --file "$APP" --group Containments --group 1 --group Wallpaper \
        --group org.kde.slideshow --group General --key SlidePaths 2>/dev/null)"
    ok "stored SlidePaths: $STORED"
else
    printf '      %s(dry) evaluateScript: desktops() → org.kde.slideshow%s\n' "$D" "$R"
fi

# ── install the global commands ───────────────────────────────────────────────
phase "Phase 5 · global commands"
for c in backup restore; do
    run sudo ln -sf "$DOTFILES/bin/$c" "/usr/local/bin/$c"
    ok "/usr/local/bin/$c → $DOTFILES/bin/$c"
done

done_ "Restore complete — log out and back in so fish (and the panel) fully apply."
